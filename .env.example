# Copy to .env and fill in. Never commit .env.

# Flagsmith organisation API key (Organisation settings → API Access → Create API Key)
FLAGSMITH_API_KEY=
# Server-side environment key for the demo app (Production environment → SDK Keys)
FLAGSMITH_ENVIRONMENT_KEY=
# Secret you set on the Flagsmith environment webhook (used to verify X-Flagsmith-Signature)
FLAGSMITH_WEBHOOK_SECRET=

# Optional bearer token for Guardian's control API (start / resume / rollback).
# Empty = local demo mode: browsers are limited to Guardian's own page on localhost, but any
# non-browser client that can reach the port is trusted (in Docker: every container on the
# compose network). Set it for anything beyond a laptop demo. The CLI reads it from here;
# the UI asks for it once per browser tab.
GUARDIAN_API_TOKEN=

# Interface `guardian run` listens on when run outside Docker (default 127.0.0.1, this machine
# only). docker-compose.yml sets 0.0.0.0 inside the container. Use 0.0.0.0 only with a token.
# GUARDIAN_HOST=127.0.0.1

# Interface the published ports bind to. 127.0.0.1 keeps the demo (well-known default
# secrets, demo switches) off your network. Change only after hardening (see docker-compose.yml).
BIND_ADDRESS=127.0.0.1

# Optional notifications
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Grafana service account token (role Editor: OSS Grafana has no annotation-only role) for
# decision annotations
GRAFANA_TOKEN=
# Only used when Grafana's data volume is first created. To change it later, use Grafana's
# profile page (the stored password wins over this value).
GRAFANA_ADMIN_PASSWORD=admin

# Optional public tunnel (profile "tunnel"), so Flagsmith can reach the webhook and Grafana.
# Only POST /webhooks/flagsmith and POST /api/annotations are forwarded. Set FLAGSMITH_WEBHOOK_SECRET
# first: Guardian refuses unsigned webhooks that arrive through the tunnel.
NGROK_AUTHTOKEN=

# Demo knobs
BUGGY_CHECKOUT=false
# Enables the demo-shop's POST /admin/bug switch (on by default in docker compose only)
DEMO_ADMIN=true
LOADGEN_USERS=200
LOADGEN_RPS=20
